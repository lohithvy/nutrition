# NutriFlow Mobile Environment Configuration

# Supabase Credentials (Public Client Keys Only - Never commit Service Keys)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# AI Vision & Intelligence APIs
EXPO_PUBLIC_OPENAI_API_KEY=
EXPO_PUBLIC_NUTRITION_AI_ENDPOINT=

# Health Integrations
EXPO_PUBLIC_APPLE_HEALTHKIT_ENABLED=true
EXPO_PUBLIC_GOOGLE_HEALTH_CONNECT_ENABLED=true
